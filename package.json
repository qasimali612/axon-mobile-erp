{
  "name": "axon-mobile-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-company mobile phone inventory ERP with serialized-device controls",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --hostname 0.0.0.0",
    "dev:local": "bash scripts/dev-local.sh",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.foundation.json --pretty false && tsc -p tsconfig.finance.json --pretty false && tsc -p tsconfig.ops.json --pretty false && tsc -p tsconfig.scripts.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db-controls": "bash scripts/run-with-env.sh tsx scripts/verify-db-controls.ts",
    "test:finance-controls": "bash scripts/run-with-env.sh tsx scripts/verify-finance-controls.ts",
    "test:journal-workflow": "bash scripts/run-with-env.sh tsx scripts/verify-journal-workflow.ts",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "tsx scripts/setup-cloud-db.ts",
    "db:prepare": "prisma generate && prisma migrate deploy && prisma db seed",
    "db:seed": "prisma db seed",
    "db:clean": "bash scripts/run-with-env.sh tsx scripts/reset-to-clean-slate.ts",
    "admin:init": "bash scripts/run-with-env.sh tsx scripts/init-admin.ts",
    "test:operational-workflow": "bash scripts/run-with-env.sh tsx scripts/verify-operational-workflow.ts",
    "test:operational-controls": "bash scripts/run-with-env.sh tsx scripts/verify-operational-controls.ts",
    "test:operational-reconciliation": "bash scripts/run-with-env.sh tsx scripts/verify-operational-reconciliation.ts",
    "test:inventory-controls-acceptance": "bash scripts/run-with-env.sh tsx scripts/verify-inventory-controls-acceptance.ts",
    "test:party-subledger-acceptance": "bash scripts/run-with-env.sh tsx scripts/verify-party-subledger-acceptance.ts",
    "test:login-session-acceptance": "bash scripts/run-with-env.sh tsx scripts/verify-login-session-acceptance.ts",
    "test:master-data-acceptance": "bash scripts/run-with-env.sh tsx scripts/verify-master-data-acceptance.ts",
    "test:operational-reversals": "bash scripts/run-with-env.sh tsx scripts/verify-operational-reversals.ts",
    "test:procurement-sales-acceptance": "bash scripts/run-with-env.sh tsx scripts/verify-procurement-sales-acceptance.ts",
    "test:pricing-payment-acceptance": "bash scripts/run-with-env.sh tsx scripts/verify-pricing-payment-acceptance.ts",
    "test:banking-acceptance": "bash scripts/run-with-env.sh tsx scripts/verify-banking-acceptance.ts",
    "test:fixed-assets-acceptance": "bash scripts/run-with-env.sh tsx scripts/verify-fixed-assets-acceptance.ts",
    "test:budgets-acceptance": "bash scripts/run-with-env.sh tsx scripts/verify-budgets-acceptance.ts",
    "test:incentives-acceptance": "bash scripts/run-with-env.sh tsx scripts/verify-incentives-acceptance.ts",
    "test:rebates-acceptance": "bash scripts/run-with-env.sh tsx scripts/verify-rebates-acceptance.ts",
    "test:reporting-acceptance": "bash scripts/run-with-env.sh tsx scripts/verify-reporting-acceptance.ts",
    "db:migration-rehearsal": "bash scripts/run-with-env.sh tsx scripts/migration-rehearsal.ts",
    "db:backup": "bash scripts/run-with-env.sh bash scripts/backup-restore-rehearsal.sh",
    "smoke": "bash scripts/run-with-env.sh tsx scripts/smoke-test.ts",
    "acceptance:all": "bash scripts/run-with-env.sh bash scripts/run-acceptance-suite.sh",
    "acceptance:fast": "bash scripts/run-with-env.sh bash scripts/run-acceptance-suite.sh --fast",
    "reports:run-schedules": "bash scripts/run-with-env.sh tsx scripts/run-report-schedules.ts",
    "test:enhancements-acceptance": "bash scripts/run-with-env.sh tsx scripts/verify-enhancements-acceptance.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "bwip-js": "^4.11.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fflate": "^0.8.3",
    "jose": "^6.1.0",
    "lucide-react": "^0.548.0",
    "next": "15.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.65.0",
    "read-excel-file": "^9.3.12",
    "recharts": "^3.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "^0.2.15",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.18.12",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "$postcss",
    "deepmerge-ts": "8.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
