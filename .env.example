# Production PostgreSQL. Require TLS according to your provider/network policy.
DATABASE_URL="postgresql://erp_app:CHANGE_ME@127.0.0.1:5432/axon_erp?schema=public"
DIRECT_DATABASE_URL="postgresql://erp_migrator:CHANGE_ME@127.0.0.1:5432/axon_erp?schema=public"

# 32+ random bytes. Used for keyed security operations; rotate through a controlled procedure.
APP_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"
SESSION_TTL_HOURS="12"

# Only for an HTTPS iframe-based development preview. Keep false for normal deployments.
PREVIEW_IFRAME_MODE="false"

# Bootstrap only: run `npm run admin:init`, then remove these values.
ADMIN_EMAIL="owner@example.com"
ADMIN_NAME="System Owner"
ADMIN_PASSWORD=""
ADMIN_COMPANY_CODE=""
ADMIN_COMPANY_NAME=""

# Demo fixtures are blocked when NODE_ENV=production.
DEMO_SEED="false"
SEED_ADMIN_PASSWORD=""

# Optional SMTP (notifications are introduced in Phase 5)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
