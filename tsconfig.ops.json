{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": null
  },
  "include": [
    "next-env.d.ts",
    "src/lib/operations/accounting.ts",
    "src/lib/operations/inventory.ts",
    "src/lib/operations/validation.ts",
    "src/lib/operations/purchase.ts",
    "src/lib/operations/sales.ts",
    "src/lib/operations/stock-return.ts",
    "src/lib/operations/stock-transfer.ts",
    "src/lib/operations/stock-adjustment.ts",
    "src/lib/operations/stock-count.ts",
    "src/lib/operations/payments.ts",
    "src/lib/operations/production.ts",
    "src/app/api/purchases/**/*.ts",
    "src/app/api/sales/**/*.ts",
    "src/app/api/payments/**/*.ts",
    "src/app/api/inventory/**/*.ts",
    "src/app/api/operations/**/*.ts",
    "src/app/api/search/route.ts",
    "src/app/api/customers/**/*.ts",
    "src/app/api/suppliers/**/*.ts",
    "src/components/inventory/**/*.tsx",
    "src/components/purchase/**/*.tsx",
    "src/components/sales/**/*.tsx",
    "src/components/parties/**/*.tsx",
    "src/components/finance/payment-register.tsx",
    "src/components/shell/erp-shell.tsx",
    "src/app/(erp)/inventory/**/*.tsx",
    "src/app/(erp)/purchases/**/*.tsx",
    "src/app/(erp)/goods-receipts/**/*.tsx",
    "src/app/(erp)/pos/**/*.tsx",
    "src/app/(erp)/sales/**/*.tsx",
    "src/app/(erp)/parties/**/*.tsx",
    "src/app/(erp)/finance/payments/**/*.tsx",
    "src/app/(erp)/page.tsx",
    "scripts/verify-stock-transfer-acceptance.ts",
    "scripts/verify-inventory-controls-acceptance.ts",
    "scripts/verify-operational-reconciliation.ts"
  ],
  "exclude": ["node_modules"]
}
