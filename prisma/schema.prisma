  branchId       String                    @db.Uuid
  warehouseId    String                    @db.Uuid
  customerId     String                    @db.Uuid
  salespersonId  String?                   @db.Uuid
  priceListId    String?                   @db.Uuid
  journalEntryId String?                   @unique @db.Uuid
  reversalOfId   String?                   @unique @db.Uuid
  invoiceNumber  String                    @db.VarChar(60)
  invoiceDate    DateTime                  @db.Date
  dueDate        DateTime?                 @db.Date
  status         OperationalDocumentStatus @default(DRAFT)
  currencyCode   String                    @db.Char(3)
  subtotal       Decimal                   @default(0) @db.Decimal(19, 4)
  discountTotal  Decimal                   @default(0) @db.Decimal(19, 4)
  taxTotal       Decimal                   @default(0) @db.Decimal(19, 4)
  grandTotal     Decimal                   @default(0) @db.Decimal(19, 4)
  costTotal      Decimal                   @default(0) @db.Decimal(19, 4)
  idempotencyKey String                    @db.VarChar(120)
  notes          String?                   @db.Text
  preparedById   String                    @db.Uuid
  approvedById   String?                   @db.Uuid
  postedById     String?                   @db.Uuid
  reversedById   String?                   @db.Uuid
  approvedAt     DateTime?                 @db.Timestamptz(3)
  postedAt       DateTime?                 @db.Timestamptz(3)
  reversedAt     DateTime?                 @db.Timestamptz(3)
  reversalReason String?                   @db.Text
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(3)

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesperson  User?               @relation("SalesInvoiceSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict)
  priceList    PriceList?          @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  reversalOf   SalesInvoice?       @relation("SalesInvoiceReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals    SalesInvoice[]      @relation("SalesInvoiceReversal")
  preparedBy   User                @relation("SalesInvoicePreparer", fields: [preparedById], references: [id], onDelete: Restrict)
  approvedBy   User?               @relation("SalesInvoiceApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  postedBy     User?               @relation("SalesInvoicePoster", fields: [postedById], references: [id], onDelete: Restrict)
  reversedBy   User?               @relation("SalesInvoiceReverser", fields: [reversedById], references: [id], onDelete: Restrict)
  lines        SalesInvoiceLine[]
  stockReturns StockReturn[]
  allocations  PaymentAllocation[]

  @@unique([companyId, invoiceNumber])
  @@unique([companyId, idempotencyKey])
  @@index([companyId, customerId, status, invoiceDate])
}

model SalesInvoiceLine {
