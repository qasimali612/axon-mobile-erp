model ProductionOrder {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  branchId          String    @db.Uuid
  bomId             String    @db.Uuid
  orderNumber       String    @db.VarChar(40)
  sourceWarehouseId String    @db.Uuid
  targetWarehouseId String    @db.Uuid
  productId         String    @db.Uuid
  variantId         String    @db.Uuid
  plannedQuantity   Decimal   @db.Decimal(19, 4)
  completedQuantity Decimal   @default(0) @db.Decimal(19, 4)
  scrappedQuantity  Decimal   @default(0) @db.Decimal(19, 4)
  unitCost          Decimal   @default(0) @db.Decimal(19, 4)
  totalCost         Decimal   @default(0) @db.Decimal(19, 4)
  status            String    @default("DRAFT") @db.VarChar(30)
  plannedStartDate  DateTime  @db.Date
  plannedEndDate    DateTime  @db.Date
  actualStartDate   DateTime? @db.Timestamptz(3)
  actualEndDate     DateTime? @db.Timestamptz(3)
  notes             String?   @db.Text
  createdById       String    @db.Uuid
  approvedById      String?   @db.Uuid
  postedById        String?   @db.Uuid
  journalEntryId    String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  company         Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch          Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  bom             Bom                       @relation(fields: [bomId], references: [id], onDelete: Restrict)
  sourceWarehouse Warehouse                 @relation("ProductionOrderSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  targetWarehouse Warehouse                 @relation("ProductionOrderTargetWarehouse", fields: [targetWarehouseId], references: [id], onDelete: Restrict)
  product         Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Restrict)
  materialsIssued ProductionMaterialIssue[]
  unitsProduced   ProductionOrderUnit[]

  @@unique([companyId, orderNumber])
  @@index([companyId, branchId, status])
}

model ProductionMaterialIssue {
  id                String   @id @default(uuid()) @db.Uuid
  productionOrderId String   @db.Uuid
  productId         String   @db.Uuid
  variantId         String   @db.Uuid
  warehouseId       String   @db.Uuid
  quantity          Decimal  @db.Decimal(19, 4)
  unitCost          Decimal  @db.Decimal(19, 4)
  totalCost         Decimal  @db.Decimal(19, 4)
  movementId        String?  @db.Uuid
  issuedAt          DateTime @default(now()) @db.Timestamptz(3)

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([productionOrderId])
}

model ProductionOrderUnit {
  id                  String   @id @default(uuid()) @db.Uuid
  productionOrderId   String   @db.Uuid
  physicalStockUnitId String   @db.Uuid
  imei1               String   @db.VarChar(20)
  imei2               String?  @db.VarChar(20)
  serialNumber        String?  @db.VarChar(60)
  qcResult            String   @default("PASS") @db.VarChar(20)
  qcNotes             String?  @db.VarChar(255)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  productionOrder   ProductionOrder   @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  physicalStockUnit PhysicalStockUnit @relation(fields: [physicalStockUnitId], references: [id], onDelete: Restrict)

  @@index([productionOrderId])
}
