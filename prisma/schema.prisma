model BomItem {
  id                 String  @id @default(uuid()) @db.Uuid
  bomId              String  @db.Uuid
  componentProductId String  @db.Uuid
  componentVariantId String  @db.Uuid
  quantity           Decimal @db.Decimal(19, 4)
  scrapTolerance     Decimal @default(0) @db.Decimal(5, 2)
