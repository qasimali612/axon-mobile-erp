model PaymentMethod {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  code              String   @db.VarChar(30)
  name              String   @db.VarChar(80)
  methodType        String   @db.VarChar(30)
  cashAccountId     String?  @db.Uuid
  bankAccountId     String?  @db.Uuid
  requiresReference Boolean  @default(false)
  sequence          Int      @default(0) @db.SmallInt
  isActive          Boolean  @default(true)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cashAccount Account?     @relation("PaymentMethodCashAccount", fields: [cashAccountId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation("PaymentMethodBankAccount", fields: [bankAccountId], references: [id], onDelete: Restrict)
  payments    Payment[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId, isActive, sequence])
}

enum PolicyDocumentType {
  PURCHASE_ORDER
  PURCHASE_RECEIPT
  SALES_INVOICE
  PAYMENT
  JOURNAL
  INVENTORY_ADJUSTMENT
}

/// Supplier-specific commercial terms for a product/variant: the supplier's own item code, their
/// latest quoted cost, lead time and minimum order quantity. Used by purchasing screens and the
/// reorder suggestion report; never used to move stock or post accounting by itself.
model SupplierItem {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  supplierId   String   @db.Uuid
  productId    String   @db.Uuid
  variantId    String?  @db.Uuid
  supplierSku  String   @db.VarChar(80)
  description  String?  @db.VarChar(180)
  lastCost     Decimal  @default(0) @db.Decimal(19, 4)
  leadTimeDays Int      @default(0) @db.SmallInt
  minOrderQty  Decimal  @default(0) @db.Decimal(19, 4)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([companyId, supplierId, supplierSku])
  @@index([companyId, productId])
  @@index([supplierId, isActive])
  @@index([variantId])
}

/// Amount-banded approval policy. When a document's total falls inside a band, the actor must also
/// hold the listed permission to move it forward. Bands are additive to the existing role grants and
/// never replace maker/checker/poster separation.
model ApprovalPolicy {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  documentType       PolicyDocumentType
  name               String             @db.VarChar(120)
  minAmount          Decimal            @default(0) @db.Decimal(19, 4)
  maxAmount          Decimal?           @db.Decimal(19, 4)
  requiredPermission String             @db.VarChar(80)
  isActive           Boolean            @default(true)
  notes              String?            @db.Text
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, documentType, name])
  @@index([companyId, documentType, isActive])
}

/// Per-user saved filter for a list/report screen. The query is stored as JSON and replayed by the
/// client; server-side validation still applies when the filters are used.
model SavedView {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  userId    String   @db.Uuid
  module    String   @db.VarChar(60)
  name      String   @db.VarChar(80)
  query     Json
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, name])
  @@index([companyId, module])
}

/// Definition of a recurring report export. The application stores and validates the definition and
/// can execute it on demand; a production host runs scripts/run-report-schedules.ts from cron or Task
/// Scheduler (there is no in-process scheduler to lose on restart).
model ReportSchedule {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  createdById   String    @db.Uuid
  name          String    @db.VarChar(120)
  reportKey     String    @db.VarChar(60)
  filters       Json
  cadence       String    @db.VarChar(20)
  recipients    String    @db.VarChar(400)
  isActive      Boolean   @default(true)
  lastRunAt     DateTime? @db.Timestamptz(3)
  lastRunStatus String?   @db.VarChar(20)
  lastRunRows   Int?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, name])
  @@index([companyId, isActive, cadence])
}

model Bom {
