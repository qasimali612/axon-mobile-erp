  journalLines                JournalEntryLine[]
  bankAccounts                BankAccount[]
  assetCostCategories         AssetCategory[]      @relation("CategoryAssetAccount")
  assetAccumCategories        AssetCategory[]      @relation("CategoryAccumAccount")
  assetExpenseCategories      AssetCategory[]      @relation("CategoryExpenseAccount")
  assetDisposalCategories     AssetCategory[]      @relation("CategoryDisposalAccount")
  fixedAssetCostMappings      FixedAsset[]         @relation("FixedAssetCostAccount")
  fixedAssetAccumMappings     FixedAsset[]         @relation("FixedAssetAccumAccount")
  fixedAssetExpenseMappings   FixedAsset[]         @relation("FixedAssetExpenseAccount")
  fixedAssetDisposalMappings  FixedAsset[]         @relation("FixedAssetDisposalAccount")
  incentiveExpensePlans       IncentivePlan[]      @relation("IncentiveExpenseAccount")
  incentivePayablePlans       IncentivePlan[]      @relation("IncentivePayableAccount")
  incentiveIncomePlans        IncentivePlan[]      @relation("IncentiveIncomeAccount")
  incentiveReceivablePlans    IncentivePlan[]      @relation("IncentiveReceivableAccount")
  receivedIncentiveIncome     ReceivedIncentive[]  @relation("ReceivedIncentiveIncomeAccount")
  receivedIncentiveReceivable ReceivedIncentive[]  @relation("ReceivedIncentiveReceivableAccount")
  rebatePrimaryPrograms       RebateProgram[]      @relation("RebatePrimaryAccount")
  rebateSettlementPrograms    RebateProgram[]      @relation("RebateSettlementAccount")
  budgetLines                 BudgetLine[]
  openingBalanceLines         OpeningBalanceLine[]
  payments                    Payment[]            @relation("PaymentAccount")
  paymentMethods              PaymentMethod[]      @relation("PaymentMethodCashAccount")

