generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum BranchType {
  HEAD_OFFICE
  RETAIL_STORE
  WHOLESALE
  DISTRIBUTION_CENTER
}

enum WarehouseType {
  MAIN
  RETAIL
  TRANSIT
  QUARANTINE
  DAMAGED
  SERVICE
}

enum LocationType {
  ZONE
  RACK
  SHELF
  BIN
}

enum TrackingMethod {
  IMEI
  SERIAL
  BATCH
  QUANTITY
}

enum CostingMethod {
  SPECIFIC
  FIFO
  WEIGHTED_AVERAGE
}

enum ProductType {
  SMARTPHONE
  FEATURE_PHONE
  TABLET
  SMARTWATCH
  ACCESSORY
  SPARE_PART
  SERVICE
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

model Company {
  id                     String        @id @default(uuid()) @db.Uuid
  code                   String        @unique @db.VarChar(20)
  name                   String        @db.VarChar(160)
  legalName              String?       @db.VarChar(200)
  logoUrl                String?       @db.Text
  registrationNumber     String?       @db.VarChar(80)
  taxRegistrationNumber  String?       @db.VarChar(80)
  addressLine1           String?       @db.VarChar(200)
  addressLine2           String?       @db.VarChar(200)
  countryCode            String        @default("PK") @db.Char(2)
  province               String?       @db.VarChar(100)
  city                   String?       @db.VarChar(100)
  postalCode             String?       @db.VarChar(20)
  phone                  String?       @db.VarChar(30)
  email                  String?       @db.VarChar(190)
  currencyCode           String        @default("PKR") @db.Char(3)
  timeZone               String        @default("Asia/Karachi") @db.VarChar(64)
  fiscalYearStartMonth   Int           @default(7) @db.SmallInt
  decimalPrecision       Int           @default(2) @db.SmallInt
  inventoryCostingMethod CostingMethod @default(SPECIFIC)
  allowNegativeStock     Boolean       @default(false)
  status                 CompanyStatus @default(ACTIVE)
  createdAt              DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(3)
  archivedAt             DateTime?     @db.Timestamptz(3)

  memberships           CompanyMembership[]
  branches              Branch[]
  warehouses            Warehouse[]
  roles                 Role[]
  categories            ProductCategory[]
  brands                Brand[]
  units                 UnitOfMeasure[]
  taxRules              TaxRule[]
  products              Product[]
  variants              ProductVariant[]
  barcodes              ProductBarcode[]
  systemSettings        SystemSetting[]
  documentSequences     DocumentSequence[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  idempotencyRecords    IdempotencyRecord[]
  attachments           Attachment[]
  accountGroups         AccountGroup[]
  accounts              Account[]
  fiscalYears           FiscalYear[]
  accountingPeriods     AccountingPeriod[]
  costCenters           CostCenter[]
  departments           Department[]
  customers             Customer[]
  suppliers             Supplier[]
  journalEntries        JournalEntry[]
  bankAccounts          BankAccount[]
  bankTransactions      BankTransaction[]
  bankStatements        BankStatement[]
  bankReconciliations   BankReconciliation[]
  assetCategories       AssetCategory[]
  fixedAssets           FixedAsset[]
  incentivePlans        IncentivePlan[]
  incentiveCalculations IncentiveCalculation[]
  incentivePayables     IncentivePayable[]
  receivedIncentives    ReceivedIncentive[]
  rebatePrograms        RebateProgram[]
  rebateCalculations    RebateCalculation[]
  budgets               Budget[]
  openingBalanceBatches OpeningBalanceBatch[]
  financialPeriodCloses FinancialPeriodClose[]
  physicalStockUnits    PhysicalStockUnit[]
  deviceIdentifiers     DeviceIdentifier[]
  inventoryLots         InventoryLot[]
  stockBalances         StockBalance[]
  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]
  purchaseOrders        PurchaseOrder[]
  purchaseReceipts      PurchaseReceipt[]
  qualityInspections    QualityInspection[]
  salesInvoices         SalesInvoice[]
  stockReturns          StockReturn[]
  stockTransfers        StockTransfer[]
  stockAdjustments      StockAdjustment[]
  stockCounts           StockCount[]
  payments              Payment[]
  priceLists            PriceList[]
  paymentMethods        PaymentMethod[]
  supplierItems         SupplierItem[]
  approvalPolicies      ApprovalPolicy[]
  savedViews            SavedView[]
  reportSchedules       ReportSchedule[]
  boms                  Bom[]
  productionOrders      ProductionOrder[]

  @@index([status])
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique @db.VarChar(190)
  fullName            String     @db.VarChar(160)
  phone               String?    @db.VarChar(30)
  passwordHash        String     @db.VarChar(100)
  status              UserStatus @default(INVITED)
  avatarUrl           String?    @db.Text
  locale              String     @default("en-PK") @db.VarChar(15)
  timeZone            String     @default("Asia/Karachi") @db.VarChar(64)
  forcePasswordChange Boolean    @default(true)
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz(3)
  lastLoginAt         DateTime?  @db.Timestamptz(3)
  passwordChangedAt   DateTime?  @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  archivedAt          DateTime?  @db.Timestamptz(3)

  memberships                   CompanyMembership[]
  sessions                      Session[]
  createdProducts               Product[]                   @relation("ProductCreator")
  managedWarehouses             Warehouse[]                 @relation("WarehouseManager")
  auditLogs                     AuditLog[]                  @relation("AuditActor")
  notifications                 Notification[]              @relation("NotificationRecipient")
  updatedSettings               SystemSetting[]             @relation("SettingUpdater")
  attachments                   Attachment[]                @relation("AttachmentUploader")
  periodsClosed                 AccountingPeriod[]          @relation("PeriodClosedBy")
  journalsPrepared              JournalEntry[]              @relation("JournalPreparedBy")
  journalsApproved              JournalEntry[]              @relation("JournalApprovedBy")
  journalsPosted                JournalEntry[]              @relation("JournalPostedBy")
  journalsReversed              JournalEntry[]              @relation("JournalReversedBy")
  salesJournalLines             JournalEntryLine[]          @relation("JournalLineSalesperson")
  bankReconciliationsPrepared   BankReconciliation[]        @relation("BankReconciliationPreparedBy")
  bankReconciliationsCompleted  BankReconciliation[]        @relation("BankReconciliationCompletedBy")
  assetsInCustody               FixedAsset[]                @relation("AssetCustodian")
  assetTransactionsCreated      AssetTransaction[]          @relation("AssetTransactionCreator")
  assetDisposalsApproved        AssetDisposal[]             @relation("AssetDisposalApprover")
  assetsPrepared                FixedAsset[]                @relation("AssetPreparer")
  assetSchedulesGenerated       AssetDepreciationSchedule[] @relation("AssetScheduleGenerator")
  budgetsPrepared               Budget[]                    @relation("BudgetCreator")
  incentiveAwards               IncentiveCalculation[]      @relation("IncentiveRecipientUser")
  incentiveCalculationsApproved IncentiveCalculation[]      @relation("IncentiveCalculationApprover")
  incentiveCalculationsPrepared IncentiveCalculation[]      @relation("IncentiveCalculationCalculator")
  receivedIncentivesPrepared    ReceivedIncentive[]         @relation("ReceivedIncentivePreparer")
  receivedIncentivesApproved    ReceivedIncentive[]         @relation("ReceivedIncentiveApprover")
  rebateCalculationsApproved    RebateCalculation[]         @relation("RebateCalculationApprover")
  rebateCalculationsPrepared    RebateCalculation[]         @relation("RebateCalculationCalculator")
  budgetsApproved               Budget[]                    @relation("BudgetApprover")
  savedViews                    SavedView[]
  reportSchedules               ReportSchedule[]
  openingBatchesCreated         OpeningBalanceBatch[]       @relation("OpeningBalanceCreator")
  openingBatchesApproved        OpeningBalanceBatch[]       @relation("OpeningBalanceApprover")
  periodClosesRequested         FinancialPeriodClose[]      @relation("PeriodCloseRequester")
  periodClosesApproved          FinancialPeriodClose[]      @relation("PeriodCloseApprover")
  inventoryMovementsCreated     InventoryMovement[]         @relation("InventoryMovementCreator")
  inventoryReservationsCreated  InventoryReservation[]      @relation("InventoryReservationCreator")
  purchaseOrdersPrepared        PurchaseOrder[]             @relation("PurchaseOrderPreparer")
  purchaseOrdersApproved        PurchaseOrder[]             @relation("PurchaseOrderApprover")
  purchaseReceiptsPrepared      PurchaseReceipt[]           @relation("PurchaseReceiptPreparer")
  purchaseReceiptsReceived      PurchaseReceipt[]           @relation("PurchaseReceiptReceiver")
  qualityInspections            QualityInspection[]         @relation("QualityInspectionInspector")
  purchaseReceiptsApproved      PurchaseReceipt[]           @relation("PurchaseReceiptApprover")
  purchaseReceiptsPosted        PurchaseReceipt[]           @relation("PurchaseReceiptPoster")
  purchaseReceiptsReversed      PurchaseReceipt[]           @relation("PurchaseReceiptReverser")
  salesInvoicesAsSalesperson    SalesInvoice[]              @relation("SalesInvoiceSalesperson")
  salesInvoicesPrepared         SalesInvoice[]              @relation("SalesInvoicePreparer")
  salesInvoicesApproved         SalesInvoice[]              @relation("SalesInvoiceApprover")
  salesInvoicesPosted           SalesInvoice[]              @relation("SalesInvoicePoster")
  salesInvoicesReversed         SalesInvoice[]              @relation("SalesInvoiceReverser")
  stockReturnsPrepared          StockReturn[]               @relation("StockReturnPreparer")
  stockReturnsApproved          StockReturn[]               @relation("StockReturnApprover")
  stockReturnsPosted            StockReturn[]               @relation("StockReturnPoster")
  stockTransfersPrepared        StockTransfer[]             @relation("StockTransferPreparer")
  stockTransfersApproved        StockTransfer[]             @relation("StockTransferApprover")
  stockTransfersPosted          StockTransfer[]             @relation("StockTransferPoster")
  stockTransfersReversed        StockTransfer[]             @relation("StockTransferReverser")
  stockAdjustmentsPrepared      StockAdjustment[]           @relation("StockAdjustmentPreparer")
  stockAdjustmentsApproved      StockAdjustment[]           @relation("StockAdjustmentApprover")
  stockAdjustmentsPosted        StockAdjustment[]           @relation("StockAdjustmentPoster")
  stockAdjustmentsReversed      StockAdjustment[]           @relation("StockAdjustmentReverser")
  stockCountsPrepared           StockCount[]                @relation("StockCountPreparer")
  stockCountsSubmitted          StockCount[]                @relation("StockCountSubmitter")
  stockCountsPosted             StockCount[]                @relation("StockCountPoster")
  paymentsPrepared              Payment[]                   @relation("PaymentPreparer")
  paymentsApproved              Payment[]                   @relation("PaymentApprover")
  paymentsPosted                Payment[]                   @relation("PaymentPoster")
  paymentsReversed              Payment[]                   @relation("PaymentReverser")

  @@index([status])
  @@index([lastLoginAt])
}

model CompanyMembership {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @db.Uuid
  userId       String           @db.Uuid
  employeeCode String?          @db.VarChar(30)
  jobTitle     String?          @db.VarChar(100)
  status       MembershipStatus @default(ACTIVE)
  isOwner      Boolean          @default(false)
  joinedAt     DateTime         @default(now()) @db.Timestamptz(3)
  endedAt      DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  userRoles UserRole[]

  @@unique([companyId, userId])
  @@unique([companyId, employeeCode])
  @@index([userId, status])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  module      String   @db.VarChar(60)
  action      String   @db.VarChar(40)
  description String   @db.VarChar(240)
  isSensitive Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  roles RolePermission[]

  @@index([module, action])
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  grantedAt    DateTime @default(now()) @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  membershipId String    @db.Uuid
  roleId       String    @db.Uuid
  branchId     String?   @db.Uuid
  warehouseId  String?   @db.Uuid
  validFrom    DateTime  @default(now()) @db.Timestamptz(3)
  validUntil   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  membership CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch     Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse  Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([membershipId, roleId])
  @@index([branchId])
  @@index([warehouseId])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  tokenHash         String    @unique @db.Char(64)
  userId            String    @db.Uuid
  activeCompanyId   String    @db.Uuid
  activeBranchId    String?   @db.Uuid
  activeWarehouseId String?   @db.Uuid
  ipAddress         String?   @db.VarChar(64)
  userAgent         String?   @db.VarChar(500)
  expiresAt         DateTime  @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model LoginAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @db.VarChar(190)
  ipAddress   String?  @db.VarChar(64)
  succeeded   Boolean  @default(false)
  reason      String?  @db.VarChar(100)
  attemptedAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
}

model Branch {
  id                    String     @id @default(uuid()) @db.Uuid
  companyId             String     @db.Uuid
  code                  String     @db.VarChar(20)
  name                  String     @db.VarChar(140)
  type                  BranchType @default(RETAIL_STORE)
  registrationNumber    String?    @db.VarChar(80)
  taxRegistrationNumber String?    @db.VarChar(80)
  addressLine1          String?    @db.VarChar(200)
  addressLine2          String?    @db.VarChar(200)
  countryCode           String     @default("PK") @db.Char(2)
  province              String?    @db.VarChar(100)
  city                  String?    @db.VarChar(100)
  phone                 String?    @db.VarChar(30)
  email                 String?    @db.VarChar(190)
  documentPrefix        String     @db.VarChar(12)
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)
  archivedAt            DateTime?  @db.Timestamptz(3)

  company                Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouses             Warehouse[]
  scopedUserRoles        UserRole[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  documentSequences      DocumentSequence[]
  accounts               Account[]
  costCenters            CostCenter[]
  departments            Department[]
  customers              Customer[]
  suppliers              Supplier[]
  journalEntries         JournalEntry[]
  journalLines           JournalEntryLine[]
  bankAccounts           BankAccount[]
  fixedAssets            FixedAsset[]
  incentivePlans         IncentivePlan[]
  incentiveCalculations  IncentiveCalculation[]
  budgets                Budget[]
  physicalStockUnits     PhysicalStockUnit[]
  productionOrders       ProductionOrder[]
  stockBalances          StockBalance[]
  inventoryMovements     InventoryMovement[]
  inventoryReservations  InventoryReservation[]
  purchaseOrders         PurchaseOrder[]
  purchaseReceipts       PurchaseReceipt[]
  salesInvoices          SalesInvoice[]
  stockReturns           StockReturn[]
  outgoingStockTransfers StockTransfer[]        @relation("StockTransferSourceBranch")
  incomingStockTransfers StockTransfer[]        @relation("StockTransferDestinationBranch")
  stockAdjustments       StockAdjustment[]
  stockCounts            StockCount[]
  payments               Payment[]

  @@unique([companyId, code])
  @@unique([companyId, documentPrefix])
  @@index([companyId, isActive])
}

model Warehouse {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @db.Uuid
  branchId       String        @db.Uuid
  code           String        @db.VarChar(24)
  name           String        @db.VarChar(140)
  type           WarehouseType @default(MAIN)
  managerId      String?       @db.Uuid
  addressLine1   String?       @db.VarChar(200)
  city           String?       @db.VarChar(100)
  phone          String?       @db.VarChar(30)
  allowReceiving Boolean       @default(true)
  allowDispatch  Boolean       @default(true)
  isDefault      Boolean       @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  archivedAt     DateTime?     @db.Timestamptz(3)

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch                   Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  manager                  User?                     @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  locations                WarehouseLocation[]
  scopedUserRoles          UserRole[]
  auditLogs                AuditLog[]
  notifications            Notification[]
  physicalStockUnits       PhysicalStockUnit[]
  stockBalances            StockBalance[]
  inventoryMovements       InventoryMovement[]
  inventoryReservations    InventoryReservation[]
  purchaseOrders           PurchaseOrder[]
  purchaseReceipts         PurchaseReceipt[]
  salesInvoices            SalesInvoice[]
  stockReturns             StockReturn[]
  outgoingStockTransfers   StockTransfer[]           @relation("StockTransferSourceWarehouse")
  incomingStockTransfers   StockTransfer[]           @relation("StockTransferDestinationWarehouse")
  stockAdjustments         StockAdjustment[]
  stockCounts              StockCount[]
  productionOrdersSource   ProductionOrder[]         @relation("ProductionOrderSourceWarehouse")
  productionOrdersTarget   ProductionOrder[]         @relation("ProductionOrderTargetWarehouse")
  productionMaterialIssues ProductionMaterialIssue[]

  @@unique([companyId, code])
  @@index([branchId, isActive])
  @@index([companyId, type])
}

model WarehouseLocation {
  id           String       @id @default(uuid()) @db.Uuid
  warehouseId  String       @db.Uuid
  parentId     String?      @db.Uuid
  code         String       @db.VarChar(30)
  name         String       @db.VarChar(100)
  type         LocationType
  barcode      String?      @db.VarChar(80)
  sequence     Int          @default(0)
  isQuarantine Boolean      @default(false)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  warehouse          Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  parent             WarehouseLocation?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           WarehouseLocation[] @relation("LocationTree")
  currentStockUnits  PhysicalStockUnit[]
  inventoryMovements InventoryMovement[]

  @@unique([warehouseId, code])
  @@index([warehouseId, parentId, isActive])
  @@index([barcode])
}

model ProductCategory {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  parentId    String?  @db.Uuid
  code        String   @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(100)
  logoUrl   String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model UnitOfMeasure {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  code          String   @db.VarChar(20)
  name          String   @db.VarChar(60)
  decimalPlaces Int      @default(0) @db.SmallInt
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([companyId, code])
}

model TaxRule {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @db.Uuid
  code               String   @db.VarChar(40)
  name               String   @db.VarChar(120)
  rate               Decimal  @db.Decimal(9, 4)
  appliesToPurchases Boolean  @default(true)
  appliesToSales     Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products             Product[]
  purchaseOrderLines   PurchaseOrderLine[]
  purchaseReceiptLines PurchaseReceiptLine[]
  salesInvoiceLines    SalesInvoiceLine[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model Product {
  id                    String         @id @default(uuid()) @db.Uuid
  companyId             String         @db.Uuid
  categoryId            String         @db.Uuid
  brandId               String?        @db.Uuid
  unitId                String         @db.Uuid
  taxRuleId             String?        @db.Uuid
  createdById           String         @db.Uuid
  sku                   String         @db.VarChar(60)
  name                  String         @db.VarChar(180)
  model                 String?        @db.VarChar(120)
  modelCode             String?        @db.VarChar(80)
  manufacturerPartNo    String?        @db.VarChar(100)
  description           String?        @db.Text
  productType           ProductType
  trackingMethod        TrackingMethod
  costingMethod         CostingMethod
  standardPurchasePrice Decimal        @default(0) @db.Decimal(19, 4)
  taxCategoryCode       String?        @db.VarChar(40)
  reorderLevel          Decimal        @default(0) @db.Decimal(19, 4)
  maxStockLevel         Decimal        @default(0) @db.Decimal(19, 4)
  preferredSupplierId   String?        @db.Uuid
  imageUrl              String?        @db.Text
  attributes            Json?
  status                ProductStatus  @default(ACTIVE)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)
  archivedAt            DateTime?      @db.Timestamptz(3)

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category                 ProductCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand                    Brand?                    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  unit                     UnitOfMeasure             @relation(fields: [unitId], references: [id], onDelete: Restrict)
